# docparse-vietocr settings. Copy to .env; real environment variables win over .env.

# Bind address. 127.0.0.1 = this machine only; 0.0.0.0 to serve the LAN (e.g. on 172.16.20.76)
DOCPARSE_HOST=127.0.0.1
DOCPARSE_PORT=8126
# Bearer token for POST /parse (Authorization: Bearer <token>). Empty = no auth (internal network)
DOCPARSE_TOKEN=
# Device for all three models: gpu:0 (first visible GPU) | cpu. CPU works but line detection is ~65x slower
DOCPARSE_DEVICE=gpu:0
# Device for VietOCR only (empty = same as DOCPARSE_DEVICE). When the card is short of memory:
# DOCPARSE_DEVICE=cpu + DOCPARSE_REC_DEVICE=gpu:0 -> ~0.5 GB VRAM instead of ~1.7 GB, ~7-8 s/page instead of ~2.5 s
DOCPARSE_REC_DEVICE=
# Line recogniser: vgg_transformer (default, 2.1% WER, ~2.5 s/page) | vgg_seq2seq (fast: 3.2% WER, ~0.7 s/page)
DOCPARSE_REC_MODEL=vgg_transformer
# Where models live (relative = to this folder). Filled once by: uv run python scripts/download_models.py
DOCPARSE_MODEL_DIR=./models
# Requests that may wait while one page is being parsed; more get 503 + Retry-After
DOCPARSE_MAX_QUEUE=8
# Per-request limit in seconds, including queue wait (then 504)
DOCPARSE_TIMEOUT_S=60
# Upload limits: file size in MB and image size in megapixels (2480x3508 A4 at 300 dpi = 8.7 MP); over = 413
DOCPARSE_MAX_UPLOAD_MB=25
DOCPARSE_MAX_MPIX=40
# Layout regions below this score are ignored
DOCPARSE_LAYOUT_MIN_SCORE=0.5
# Which physical GPU the process sees (standard CUDA variable, passed through). On 76 this must be 0:
# GPU 0 = RTX 5060 Ti shared with the reranker, GPU 1 = RTX 5080 full with Ollama
#CUDA_VISIBLE_DEVICES=0
